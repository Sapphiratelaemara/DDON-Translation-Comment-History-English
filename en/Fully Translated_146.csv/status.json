{
  "146.csv::0": {
    "id": "146.csv::0",
    "source_text": "力こそが真実――ああ、美しき世界よ",
    "translated_text": "Power Is Truth—ah, what a beautiful world",
    "status": "pre-translated",
    "translator": "pretranslate",
    "approver": null,
    "created_at": "2026-11-20T23:58:25.226693",
    "updated_at": "2026-11-21T15:38:30.651383",
