    "row_index": 0,
    "speaker": "The Evil Dragon",
    "entry_type": "Quest Dialogue"
  },
  "146.csv::1": {
    "id": "146.csv::1",
    "source_text": "竜だけに許されし究極の愉悦がわかるか",
    "translated_text": "Dost thou comprehend the ultimate ecstasy granted solely to dragonkind?",
    "status": "pre-translated",
    "translator": "pretranslate",
    "approver": null,
    "created_at": "2026-11-20T23:58:30.609612",
    "updated_at": "2026-11-21T15:38:41.759612",
    "approved_at": null,
    "file_path": "C:/DDON-translation/English/Fully Translated\\146.csv",
    "row_index": 1,
    "speaker": "The Evil Dragon",
    "entry_type": "Quest Dialogue"
  },
  "146.csv::2": {
    "id": "146.csv::2",
    "source_text": "アヒャヒャヒャヒャ――",
    "translated_text": "Ahahaha...",
    "status": "pre-translated",
    "translator": "pretranslate",
    "approver": null,
    "created_at": "2026-11-20T23:58:53.112944",
    "updated_at": "2026-11-21T15:38:55.874935",
    "approved_at": null,
    "file_path": "C:/DDON-translation/English/Fully Translated\\146.csv",
    "row_index": 2,
    "speaker": "The Evil Dragon",
    "entry_type": "Quest Dialogue"
  },
  "146.csv::3": {
    "id": "146.csv::3",
    "source_text": "叩きつぶす快感――噛み千切る喜び――",
    "translated_text": "The ecstasy of crushing... the delight of tearing asunder...",
    "status": "pre-translated",
    "translator": "pretranslate",
    "approver": null,
    "created_at": "2026-11-20T23:59:05.251106",
    "updated_at": "2026-11-21T15:39:10.860628",
    "approved_at": null,
    "file_path": "C:/DDON-translation/English/Fully Translated\\146.csv",
    "row_index": 3,
    "speaker": "The Evil Dragon",
    "entry_type": "Quest Dialogue"
  },
  "146.csv::4": {
    "id": "146.csv::4",
    "source_text": "ネドの死は――弱者の末路よ！",
    "translated_text": "Nedo&#x27;s death... is the fate of the weak!",
    "status": "pre-translated",
    "translator": "pretranslate",
    "approver": null,
    "created_at": "2026-11-20T23:59:23.115620",
    "updated_at": "2026-11-21T15:39:19.370341",
    "approved_at": null,
    "file_path": "C:/DDON-translation/English/Fully Translated\\146.csv",
    "row_index": 4,
    "speaker": "The Evil Dragon",
    "entry_type": "Quest Dialogue"
  },
  "146.csv::5": {
    "id": "146.csv::5",
    "source_text": "さあ覚者たちよ、我が力の前に倒れ伏すがよい",
    "translated_text": "Now then, Arisen, fall prostrate before my power.",
    "status": "pre-translated",
    "translator": "pretranslate",
    "approver": null,
    "created_at": "2026-11-20T23:59:30.346609",
    "updated_at": "2026-11-21T15:39:35.146164",
    "approved_at": null,
    "file_path": "C:/DDON-translation/English/Fully Translated\\146.csv",
    "row_index": 5,
    "speaker": "The Evil Dragon",
    "entry_type": "Quest Dialogue"
  },
  "146.csv::6": {
    "id": "146.csv::6",
    "source_text": "貴様らを捻り潰したらまた大地を巡ろう",
    "translated_text": "Once I have crushed you all, I shall tour the earth anew.",
    "status": "pre-translated",
    "translator": "pretranslate",
    "approver": null,
    "created_at": "2026-11-20T23:59:40.869431",
    "updated_at": "2026-11-21T15:39:45.914241",
    "approved_at": null,
    "file_path": "C:/DDON-translation/English/Fully Translated\\146.csv",
    "row_index": 6,
    "speaker": "The Evil Dragon",
    "entry_type": "Quest Dialogue"
  },
  "146.csv::7": {
    "id": "146.csv::7",
    "source_text": "逃げ惑う人間はまるで虫ケラ",
    "translated_text": "Humans scurrying in panic are naught but worms.",
    "status": "pre-translated",
    "translator": "pretranslate",
    "approver": null,
    "created_at": "2026-11-20T23:59:52.673309",
    "updated_at": "2026-11-21T15:40:20.809268",
    "approved_at": null,
    "file_path": "C:/DDON-translation/English/Fully Translated\\146.csv",
    "row_index": 7,
    "speaker": "The Evil Dragon",
    "entry_type": "Quest Dialogue"
  },
  "146.csv::8": {
    "id": "146.csv::8",
    "source_text": "おびえる人間を踏みしだく――",
    "translated_text": "I trample the trembling mortals—",
    "status": "pre-translated",
    "translator": "pretranslate",
    "approver": null,
    "created_at": "2026-11-20T23:59:58.025855",
    "updated_at": "2026-11-21T15:40:33.780063",
    "approved_at": null,
    "file_path": "C:/DDON-translation/English/Fully Translated\\146.csv",
    "row_index": 8,
    "speaker": "The Evil Dragon",
    "entry_type": "Quest Dialogue"
  },
  "146.csv::9": {
    "id": "146.csv::9",
    "source_text": "我が父であり母である黒き竜よ――",
    "translated_text": "O Black Dragon, who art both my father and my mother—",
    "status": "pre-translated",
    "translator": "pretranslate",
    "approver": null,
    "created_at": "2026-11-21T00:00:06.604343",
    "updated_at": "2026-11-21T15:40:53.949426",
    "approved_at": null,
    "file_path": "C:/DDON-translation/English/Fully Translated\\146.csv",
    "row_index": 9,
    "speaker": "The Evil Dragon",
    "entry_type": "Quest Dialogue"
  },
  "146.csv::10": {
    "id": "146.csv::10",
    "source_text": "この者達の血を捧ごう――",
    "translated_text": "I shall offer up the blood of these ones—",
    "status": "pre-translated",
    "translator": "pretranslate",
    "approver": null,
    "created_at": "2026-11-21T00:00:18.471013",
    "updated_at": "2026-11-21T15:41:05.279777",
