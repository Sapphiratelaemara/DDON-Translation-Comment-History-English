{
  "169.csv::48": {
    "id": "169.csv::48",
    "source_text": "竜は理から生まれた――",
    "translated_text": "Dragons are born of Order—",
    "status": "pre-translated",
    "translator": "pretranslate",
    "approver": null,
    "created_at": "2026-11-20T22:37:46.199031",
    "updated_at": "2026-11-20T23:01:40.389235",
    "approved_at": null,
    "file_path": "C:/DDON-translation/English/splits\\169.csv",
    "row_index": 48,
    "speaker": "Black Dragon",
    "entry_type": "Quest Dialogue"
  },
  "169.csv::49": {
    "id": "169.csv::49",
    "source_text": "竜は理の守護者――",
    "translated_text": "Dragons are the guardians of Order—",
    "status": "pre-translated",
    "translator": "pretranslate",
    "approver": null,
    "created_at": "2026-11-20T22:37:49.412189",
    "updated_at": "2026-11-20T23:01:50.370391",
    "approved_at": null,
    "file_path": "C:/DDON-translation/English/splits\\169.csv",
    "row_index": 49,
    "speaker": "Black Dragon",
    "entry_type": "Quest Dialogue"
  },
  "169.csv::50": {
    "id": "169.csv::50",
    "source_text": "わたしは知ったのだ――",
    "translated_text": "I have come to know—",
    "status": "pre-translated",
    "translator": "pretranslate",
    "approver": null,
    "created_at": "2026-11-20T22:37:52.575386",
    "updated_at": "2026-11-20T23:01:59.042452",
    "approved_at": null,
    "file_path": "C:/DDON-translation/English/splits\\169.csv",
    "row_index": 50,
    "speaker": "Black Dragon",
    "entry_type": "Quest Dialogue"
  },
  "169.csv::51": {
    "id": "169.csv::51",
    "source_text": "理はわたしを縛りつける――",
    "translated_text": "Order binds me—",
    "status": "pre-translated",
    "translator": "pretranslate",
    "approver": null,
    "created_at": "2026-11-20T22:37:55.720933",
    "updated_at": "2026-11-20T23:02:21.433433",
    "approved_at": null,
    "file_path": "C:/DDON-translation/English/splits\\169.csv",
    "row_index": 51,
    "speaker": "Black Dragon",
    "entry_type": "Quest Dialogue"
  },
  "169.csv::52": {
    "id": "169.csv::52",
    "source_text": "理はこの狭き世界にわたしを閉じ込める",
    "translated_text": "Order imprisons me within this narrow world",
    "status": "pre-translated",
    "translator": "pretranslate",
    "approver": null,
    "created_at": "2026-11-20T22:37:58.983097",
    "updated_at": "2026-11-20T23:02:32.953284",
    "approved_at": null,
    "file_path": "C:/DDON-translation/English/splits\\169.csv",
    "row_index": 52,
    "speaker": "Black Dragon",
    "entry_type": "Quest Dialogue"
  },
  "169.csv::53": {
    "id": "169.csv::53",
    "source_text": "理の外とは如何なるものか――",
    "translated_text": "What manner of thing lies beyond Order—",
    "status": "pre-translated",
    "translator": "pretranslate",
    "approver": null,
    "created_at": "2026-11-20T22:38:02.165494",
    "updated_at": "2026-11-20T23:02:50.585874",
    "approved_at": null,
    "file_path": "C:/DDON-translation/English/splits\\169.csv",
    "row_index": 53,
    "speaker": "Black Dragon",
    "entry_type": "Quest Dialogue"
  },
  "169.csv::54": {
    "id": "169.csv::54",
    "source_text": "わたしはその理の外を見たい――",
    "translated_text": "I would see beyond that Order—",
    "status": "pre-translated",
    "translator": "pretranslate",
    "approver": null,
    "created_at": "2026-11-20T22:38:05.402702",
    "updated_at": "2026-11-20T23:03:21.945170",
    "approved_at": null,
    "file_path": "C:/DDON-translation/English/splits\\169.csv",
    "row_index": 54,
    "speaker": "Black Dragon",
    "entry_type": "Quest Dialogue"
  },
  "169.csv::55": {
    "id": "169.csv::55",
    "source_text": "理の壁を壊してやろう",
    "translated_text": "I shall sunder the wall of Order.",
    "status": "pre-translated",
    "translator": "pretranslate",
    "approver": null,
    "created_at": "2026-11-20T22:38:08.612945",
    "updated_at": "2026-11-20T23:03:32.443524",
    "approved_at": null,
    "file_path": "C:/DDON-translation/English/splits\\169.csv",
    "row_index": 55,
    "speaker": "Black Dragon",
    "entry_type": "Quest Dialogue"
  },
  "169.csv::56": {
    "id": "169.csv::56",
    "source_text": "もはや何人もわたしを止めることは出来ぬ",
    "translated_text": "None can halt me now.",
    "status": "pre-translated",
    "translator": "pretranslate",
    "approver": null,
    "created_at": "2026-11-20T22:38:12.018613",
    "updated_at": "2026-11-20T23:03:43.002217",
    "approved_at": null,
    "file_path": "C:/DDON-translation/English/splits\\169.csv",
    "row_index": 56,
    "speaker": "Black Dragon",
    "entry_type": "Quest Dialogue"
  },
  "169.csv::57": {
    "id": "169.csv::57",
    "source_text": "この世界を壊して穴をあけるのだ――",
    "translated_text": "I shall shatter this world and bore a hole through it—",
    "status": "pre-translated",
    "translator": "pretranslate",
    "approver": null,
    "created_at": "2026-11-20T22:38:15.331518",
    "updated_at": "2026-11-20T23:03:55.568373",
    "approved_at": null,
    "file_path": "C:/DDON-translation/English/splits\\169.csv",
    "row_index": 57,
    "speaker": "Black Dragon",
    "entry_type": "Quest Dialogue"
  },
  "169.csv::58": {
    "id": "169.csv::58",
    "source_text": "もうすぐ終わる――",
    "translated_text": "The end draws nigh—",
    "status": "pre-translated",
    "translator": "pretranslate",
    "approver": null,
    "created_at": "2026-11-20T22:38:18.369206",
    "updated_at": "2026-11-20T23:04:27.642201",
    "approved_at": null,
    "file_path": "C:/DDON-translation/English/splits\\169.csv",
    "row_index": 58,
    "speaker": "Black Dragon",
    "entry_type": "Quest Dialogue"
  },
  "169.csv::59": {
    "id": "169.csv::59",
    "source_text": "おまえたちを倒し――",
    "translated_text": "Vanquishing the lot of you—",
    "status": "pre-translated",
    "translator": "pretranslate",
    "approver": null,
    "created_at": "2026-11-20T22:38:21.468563",
    "updated_at": "2026-11-20T23:05:02.545204",
    "approved_at": null,
    "file_path": "C:/DDON-translation/English/splits\\169.csv",
    "row_index": 59,
    "speaker": "Black Dragon",
    "entry_type": "Quest Dialogue"
  },
  "169.csv::60": {
    "id": "169.csv::60",
    "source_text": "わたしは理の外を見よう――",
    "translated_text": "I shall see beyond Order—",
    "status": "pre-translated",
    "translator": "pretranslate",
    "approver": null,
    "created_at": "2026-11-20T22:38:24.698111",
    "updated_at": "2026-11-20T23:05:10.817918",
    "approved_at": null,
    "file_path": "C:/DDON-translation/English/splits\\169.csv",
    "row_index": 60,
    "speaker": "Black Dragon",
    "entry_type": "Quest Dialogue"
  }
}